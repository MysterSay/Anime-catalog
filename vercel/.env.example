# Optional protection for POST /api/process.
CORE_API_KEY=

# Destination [[Сайт]] that will receive the final JSON after collection.
# Leave empty during local development; /api/process will still return the JSON response.
RESULT_WEBHOOK_URL=
RESULT_WEBHOOK_TOKEN=

# Optional. YummyAnime API requires X-Application for its API search.
# Without it the core falls back to the website's own search and then Google site: search.
YUMMY_APPLICATION_TOKEN=

# Optional console diagnostics (useful locally / in Vercel logs).
ANIME_CORE_VERBOSE=0
